# -----------------------------------------------------------------------------
# Injected at RUNTIME, not at build time:
# - In production the CI workflow writes env-config.js (window.__ENV__ = {...})
#   into dist/ from these variables, before the rsync.
# - In local dev the Vite dev server answers the /env-config.js request from the
#   same variables (the process environment or this file), so nothing is rebuilt.
# - The values reach the browser: they are PUBLIC. Never put secrets in them.
# - Do not quote values (docker --env-file keeps the quotes). An empty value is
#   treated as unset, which means the default.
# -----------------------------------------------------------------------------

# Origin of the host that serves the static map files, optionally followed by a path
# prefix, e.g. https://maps.example.com
# (no query or hash, trailing slashes are dropped). The app requests <MAP_HOST>/map/...:
#   hcmc-roads.geojson, hcmc-boundary.geojson, hcmc-roads.pmtiles,
#   tiles/{z}/{x}/{y}.pbf and tiles/metadata.json (tile zoom limits are read from it).
# Unset or empty = the same origin as the app (local dev: apps/web/public/map).
# A different host needs CORS (Access-Control-Allow-Origin), Timing-Allow-Origin (so
# the benchmark can read byte sizes) and, for PMTiles, HTTP Range support with
# Content-Range and Accept-Ranges exposed via Access-Control-Expose-Headers.
MAP_HOST=

# Basemap style JSON (MapLibre style).
BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
