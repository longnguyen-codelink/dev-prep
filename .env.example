# Runtime values: the dev server reads them from the environment or apps/web/.env*, CI writes them into dist/env-config.js.
# They reach the browser, so they are PUBLIC. Do not quote values.

# Origin of the host serving the static map files, optionally followed by a path prefix,
# e.g. https://example.com/public/dev-challenge-gis
# The app requests <MAP_HOST>/map/... Unset = same origin (local dev: apps/web/public/map).
# A different host needs CORS, Timing-Allow-Origin and HTTP Range support.
MAP_HOST=

# Build info shown as a chip (top-left) that links to the commit on GitHub.
# CI sets both from the GitHub context (commit SHA and repository URL). Leave them empty locally and the chip is hidden;
# set them locally only to preview the chip, e.g. BUILD_COMMIT=<full sha>, BUILD_REPO_URL=https://github.com/<owner>/<repo>.
# BUILD_COMMIT must be a 7-40 character hex SHA and BUILD_REPO_URL must start with https://, otherwise the chip stays hidden.
BUILD_COMMIT=
BUILD_REPO_URL=
