{
  "name": "gis-dev-prep",
  "image": "ghcr.io/voidzero-dev/vite-plus:latest",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2.7.1": {
      "username": "vp",
      "installZsh": false,
      "installOhMyZsh": false,
      "upgradePackages": false
    },
    "ghcr.io/devcontainers-extra/features/apt-get-packages:1.0.8": {
      "packages": "gdal-bin,osmium-tool"
    },
    "ghcr.io/devcontainers/features/git:1.3.8": {
      "version": "os-provided"
    },
    "ghcr.io/eitsupi/devcontainer-features/jq-likes:2.1.1": {
      "jqVersion": "latest"
    },
    "ghcr.io/code-fabrik/features/tippecanoe:1.0.1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0.5": {}
  },
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh,target=/home/vp/.ssh,type=bind,consistency=cached,readonly",
    "source=gis-dev-prep-pnpm-store,target=/opt/pnpm/store,type=volume",
    "source=zsh-history-cache,target=/home/vp/.zsh_history_cache,type=volume",
    "source=${localEnv:HOME}/.claude,target=/home/vp/.claude,type=bind,consistency=cached"
  ],
  "remoteUser": "vp",
  "forwardPorts": [
    8080,
    5173
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "esbenp.prettier-vscode",
        "oxc.oxc-vscode",
        "Vue.volar",
        "formulahendry.auto-complete-tag",
        "bradlc.vscode-tailwindcss",
        "VoidZero.vite-plus-extension-pack"
      ]
    }
  },
  "postCreateCommand": "bash .devcontainer/commands/init.sh"
}